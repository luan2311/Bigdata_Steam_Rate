{
  "flowEncodingVersion": "1.0",
  "flow": {
    "identifier": "steam-reviews-ingestion-v1",
    "instanceIdentifier": "8f2e4b3c-910a-4a21-9923-d8b5a1b3e100",
    "name": "Steam Reviews Ingestion Flow (Sample 10K)",
    "comments": "Luồng tiếp nhận dữ liệu Steam Reviews mẫu (~10.000 bản ghi) từ thư mục cục bộ vào HDFS Bronze qua WebHDFS REST API",
    "position": {
      "x": 300.0,
      "y": 100.0
    },
    "processGroups": [],
    "processors": [
      {
        "identifier": "proc-list-file-01",
        "name": "ListFile - Quét tệp mẫu",
        "type": "org.apache.nifi.processors.standard.ListFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "properties": {
          "Input Directory": "/opt/nifi/data/sample",
          "File Filter": "steam_reviews_sample_10k\\.csv",
          "Recurse Subdirectories": "false",
          "Minimum File Age": "0 sec"
        },
        "schedulingPeriod": "10 sec",
        "schedulingStrategy": "TIMER_DRIVEN"
      },
      {
        "identifier": "proc-fetch-file-02",
        "name": "FetchFile - Nạp nội dung tệp",
        "type": "org.apache.nifi.processors.standard.FetchFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "properties": {
          "File to Fetch": "${absolute.path}/${filename}",
          "Completion Strategy": "None"
        }
      },
      {
        "identifier": "proc-split-record-03",
        "name": "SplitRecord - Chia lô theo bản ghi logic",
        "type": "org.apache.nifi.processors.standard.SplitRecord",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "properties": {
          "Record Reader": "service-csv-reader-01",
          "Record Writer": "service-csv-writer-01",
          "Records Per Split": "5000"
        }
      },
      {
        "identifier": "proc-update-attr-04",
        "name": "UpdateAttribute - Đính kèm Metadata & Batch ID",
        "type": "org.apache.nifi.processors.attributes.UpdateAttribute",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-update-attribute-nar",
          "version": "2.0.0"
        },
        "properties": {
          "batch_id": "batch_sample_${now():format('yyyyMMdd_HHmmss')}_${fragment.index}",
          "webhdfs.target.path": "/steam/bronze/sample/batch_${fragment.index}.csv",
          "webhdfs.url": "http://hdfs-namenode:9870/webhdfs/v1/steam/bronze/sample/batch_${fragment.index}.csv?op=CREATE&overwrite=true"
        }
      },
      {
        "identifier": "proc-invoke-http-05",
        "name": "InvokeHTTP - Đẩy vào HDFS qua WebHDFS",
        "type": "org.apache.nifi.processors.standard.InvokeHTTP",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "properties": {
          "HTTP Method": "PUT",
          "Remote URL": "${webhdfs.url}",
          "Follow Redirects": "true",
          "Connection Timeout": "30 secs",
          "Read Timeout": "30 secs",
          "Content-Type": "text/csv; charset=UTF-8",
          "Send Message Body": "true"
        }
      },
      {
        "identifier": "proc-log-quarantine-06",
        "name": "LogAttribute - Cách ly bản ghi lỗi (Quarantine)",
        "type": "org.apache.nifi.processors.standard.LogAttribute",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.0.0"
        },
        "properties": {
          "Log Level": "warn",
          "Log Payload": "false",
          "Attributes to Log": "filename,batch_id,record.error,invokehttp.status.code"
        }
      }
    ],
    "controllerServices": [
      {
        "identifier": "service-csv-reader-01",
        "name": "CSVReader - Bộ đọc Record đa dòng hỗ trợ Unicode",
        "type": "org.apache.nifi.csv.CSVReader",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-record-serialization-services-nar",
          "version": "2.0.0"
        },
        "properties": {
          "schema-access-strategy": "infer-schema",
          "csv-reader-csv-parser": "commons-csv",
          "value-separator": ",",
          "skip-header-line": "true",
          "quote-character": "\"",
          "escape-character": "\\",
          "character-set": "UTF-8"
        }
      },
      {
        "identifier": "service-csv-writer-01",
        "name": "CSVRecordSetWriter - Bộ ghi Record chuẩn hóa UTF-8",
        "type": "org.apache.nifi.csv.CSVRecordSetWriter",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-record-serialization-services-nar",
          "version": "2.0.0"
        },
        "properties": {
          "schema-access-strategy": "inherit-record-schema",
          "value-separator": ",",
          "include-header-line": "true",
          "quote-character": "\"",
          "escape-character": "\\",
          "character-set": "UTF-8"
        }
      }
    ],
    "connections": [
      {
        "identifier": "conn-01",
        "name": "ListFile -> FetchFile",
        "source": { "id": "proc-list-file-01", "type": "PROCESSOR" },
        "destination": { "id": "proc-fetch-file-02", "type": "PROCESSOR" },
        "selectedRelationships": ["success"],
        "backPressureObjectThreshold": 10000,
        "backPressureDataSizeThreshold": "1 GB"
      },
      {
        "identifier": "conn-02",
        "name": "FetchFile -> SplitRecord",
        "source": { "id": "proc-fetch-file-02", "type": "PROCESSOR" },
        "destination": { "id": "proc-split-record-03", "type": "PROCESSOR" },
        "selectedRelationships": ["success"],
        "backPressureObjectThreshold": 10000,
        "backPressureDataSizeThreshold": "1 GB"
      },
      {
        "identifier": "conn-03",
        "name": "SplitRecord -> UpdateAttribute (Các lô thành công)",
        "source": { "id": "proc-split-record-03", "type": "PROCESSOR" },
        "destination": { "id": "proc-update-attr-04", "type": "PROCESSOR" },
        "selectedRelationships": ["splits"],
        "backPressureObjectThreshold": 10000,
        "backPressureDataSizeThreshold": "1 GB"
      },
      {
        "identifier": "conn-04",
        "name": "SplitRecord -> Quarantine (Bản ghi lỗi phân tích cú pháp)",
        "source": { "id": "proc-split-record-03", "type": "PROCESSOR" },
        "destination": { "id": "proc-log-quarantine-06", "type": "PROCESSOR" },
        "selectedRelationships": ["failure"],
        "backPressureObjectThreshold": 1000
      },
      {
        "identifier": "conn-05",
        "name": "UpdateAttribute -> InvokeHTTP (WebHDFS)",
        "source": { "id": "proc-update-attr-04", "type": "PROCESSOR" },
        "destination": { "id": "proc-invoke-http-05", "type": "PROCESSOR" },
        "selectedRelationships": ["success"],
        "backPressureObjectThreshold": 10000,
        "backPressureDataSizeThreshold": "1 GB"
      },
      {
        "identifier": "conn-06",
        "name": "InvokeHTTP -> Quarantine (Lỗi khi gửi HTTP)",
        "source": { "id": "proc-invoke-http-05", "type": "PROCESSOR" },
        "destination": { "id": "proc-log-quarantine-06", "type": "PROCESSOR" },
        "selectedRelationships": ["failure", "no-retry"],
        "backPressureObjectThreshold": 1000
      }
    ]
  }
}
